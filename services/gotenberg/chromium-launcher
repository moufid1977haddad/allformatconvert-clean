#!/bin/bash
# P29 (04/10): how Gotenberg starts Chromium (CHROMIUM_BIN_PATH points here, see the Dockerfile).
# Chromium runs without its own sandbox: Gotenberg passes --no-sandbox, and Railway leaves no way to turn it on (measured
# 04/10 on gotenberg-fonts: Railway's seccomp filter refuses user namespaces on most hosts, and the container has no
# CAP_SYS_ADMIN for the setuid helper -- Chromium aborts at sandbox/linux/services/credentials.cc). So, in depth:
#   - page scripts never run (--chromium-disable-javascript in the Dockerfile's CMD: 0 of 18 ways measured);
#   - V8 is started without its JIT compiler (--jitless), the part most V8 exploits target, in case any script
#     still ran;
#   - Gotenberg's own API credentials are not handed to Chromium's environment.
exec env -u GOTENBERG_API_BASIC_AUTH_USERNAME -u GOTENBERG_API_BASIC_AUTH_PASSWORD \
  /usr/bin/chromium "$@" --js-flags=--jitless
